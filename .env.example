# ============================================
# BeHeard Backend - Environment Configuration
# ============================================

# Server (DigitalOcean App Platform sets PORT itself)
PORT=3000
NODE_ENV=production

# Public URL of the app, e.g. https://beheard-xxxxx.ondigitalocean.app
# Used for Meta OAuth callbacks and public image URLs for Meta publishing.
APP_URL=https://your-app.ondigitalocean.app

# Frontend origin(s), comma-separated. On DigitalOcean this is the same URL
# as APP_URL. Leave empty in local dev to allow any origin.
CLIENT_URL=https://your-app.ondigitalocean.app

# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/beheard?retryWrites=true&w=majority

# Auth - required. Use a long random string (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-this-to-a-long-random-secret

# AI APIs
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the Claude model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Meta (Facebook/Instagram) - optional, only for publishing/analytics
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version (default: v23.0)
# META_API_VERSION=
